{
  "app": {
    // Debug signing material is generated by DevEco Studio (File > Project
    // Structure > Signing Configs). A HAP is only installable once this project
    // has its own certificate and profile, and those are bound to the Huawei
    // account doing the build.
    //
    // The store build is signed separately, see tools/sign-release.ps1: hvigor
    // refuses plaintext passwords ("length ... is less than 32") and only takes
    // blobs encrypted by the DevEco GUI, so the release product below is built
    // unsigned and signed afterwards with the SDK's hap-sign-tool.
    "signingConfigs": [
      {
        "name": "default",
        "type": "HarmonyOS",
        "material": {
          "certpath": "C:\\Users\\Crimson\\.ohos\\config\\default_spektrafilm-ohos_CH1hNt8r56Mn4SqOFdyjs69Z35dSn-OrMghIdw0ah_s=.cer",
          "keyAlias": "debugKey",
          "keyPassword": "0000001B49DC4260E0D8B7132CBF5B1B9F6A82992A9A863DD9C38551846B4F2748E626787B7F5C9401CDB8",
          "profile": "C:\\Users\\Crimson\\.ohos\\config\\default_spektrafilm-ohos_CH1hNt8r56Mn4SqOFdyjs69Z35dSn-OrMghIdw0ah_s=.p7b",
          "signAlg": "SHA256withECDSA",
          "storeFile": "C:\\Users\\Crimson\\.ohos\\config\\default_spektrafilm-ohos_CH1hNt8r56Mn4SqOFdyjs69Z35dSn-OrMghIdw0ah_s=.p12",
          "storePassword": "0000001B72C09B0C8E45929530DD858FEC8C84C3574E44FC6BFD5D1E7A6A7995CCB5F6AB6E9F976536A3EA"
        }
      }
    ],
    "products": [
      {
        "name": "default",
        "signingConfig": "default",
        // Compiled with SDK 26 (the only one installed here) but allowed to run
        // on HarmonyOS 5.0 onwards, so the app installs on a MatePad on 5.x.
        // API 10..25 uses the "x.y.z(api)" form; API 26+ uses the bare version.
        "compatibleSdkVersion": "5.0.0(12)",
        "targetSdkVersion": "26.0.0",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      },
      {
        // No signingConfig on purpose: this product is signed by hand.
        "name": "release",
        "compatibleSdkVersion": "5.0.0(12)",
        "targetSdkVersion": "26.0.0",
        "runtimeOS": "HarmonyOS",
        "buildOption": {
          "strictMode": {
            "caseSensitiveCheck": true,
            "useNormalizedOHMUrl": true
          }
        }
      }
    ],
    "buildModeSet": [
      {
        "name": "debug"
      },
      {
        "name": "release"
      }
    ]
  },
  "modules": [
    {
      "name": "entry",
      "srcPath": "./entry",
      "targets": [
        {
          "name": "default",
          "applyToProducts": [
            "default",
            "release"
          ]
        }
      ]
    }
  ]
}
